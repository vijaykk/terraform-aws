class WebhookRetryBackoff
  RETRY_DURATIONS = [0, 2, 6, 15, 30, 65, 130, 254, 510, 1022, 2046, 4094].freeze

  RETRY_OPTIONS = RETRY_DURATIONS.each_with_index.to_h do |duration_minutes, retries|
    [
      retries.to_s,
      {
        retries: retries,
        duration_minutes: duration_minutes,
        display_text: display_text(retries, duration_minutes)
      }
    ]
  end.freeze

  def self.all_options
    RETRY_OPTIONS.map { |key, config| config.merge(key: key) }
  end

  def self.parse(key)
    parsed_key = key.to_s
    value = RETRY_OPTIONS[parsed_key]

    value&.merge(key: parsed_key)
  end

  def self.for_retries(retry_count)
    all_options.find { |option| option[:retries] == retry_count.to_i }
  end

  def self.display_text(retries, duration_minutes)
    return "No retries" if retries.zero?

    duration_text =
      if duration_minutes < 60
        "#{duration_minutes} minutes"
      else
        hours = duration_minutes / 60
        minutes = duration_minutes % 60

        minutes.zero? ? "#{hours} hours" : "#{hours} hours and #{minutes} minutes"
      end

    retry_text = retries == 1 ? "1 retry" : "#{retries} retries"

    "#{retry_text} for the duration of #{duration_text}"
  end

  private_class_method :display_text
end
